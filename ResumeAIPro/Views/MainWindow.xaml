<Window x:Class="ResumeAIPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ResumeAIPro.ViewModels"
        xmlns:conv="clr-namespace:ResumeAIPro.Converters"
        xmlns:ctrl="clr-namespace:ResumeAIPro.Controls"
        Title="ResumeAI Pro"
        Height="860" Width="1300"
        MinHeight="660" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBg}"
        Foreground="White"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="5" CaptionHeight="48"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolVis"/>
        <conv:ScoreToBrushConverter      x:Key="ScoreBrush"/>
        <conv:HexToBrushConverter        x:Key="HexBrush"/>
        <conv:OutlookToColorConverter    x:Key="OutlookColor"/>
        <conv:InverseBoolConverter       x:Key="InvBool"/>
        <conv:ScoreToStringConverter     x:Key="ScoreStr"/>
    </Window.Resources>

    <!-- Root: Sidebar + Content -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════ SIDEBAR ════════════════════ -->
        <Border Grid.Column="0" BorderThickness="0 0 1 0" BorderBrush="{StaticResource BorderBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0E0B1E" Offset="0"/>
                    <GradientStop Color="#080611" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" BorderThickness="0 0 0 1" BorderBrush="{StaticResource BorderBrush}"
                        Padding="16 0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0 0 10 0"
                                ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/ResumeAIPro_LOGO.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ResumeAI Pro" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="Career Intelligence" FontSize="10"
                                       Foreground="{StaticResource MutedText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav (indices 0-6 map directly to TabControl tabs 0-6) -->
                <ListBox x:Name="SidebarNavList"
                         Grid.Row="1"
                         SelectedIndex="{Binding CurrentTabIndex, Mode=OneWay}"
                         Background="Transparent" BorderThickness="0"
                         Margin="0 8 0 8"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="SidebarNav_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ViewDashboard" Width="17" Height="17" Margin="0 0 10 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Upload" Width="17" Height="17" Margin="0 0 10 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Upload Resume" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ChartBar" Width="17" Height="17" Margin="0 0 10 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Analysis" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Target" Width="17" Height="17" Margin="0 0 10 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Job Match" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileEdit" Width="17" Height="17" Margin="0 0 10 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cover Letter" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="MagnifyExpand" Width="17" Height="17" Margin="0 0 10 0" VerticalAlignment="Center"/>
                            <TextBlock Text="Job Finder" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="History" Width="17" Height="17" Margin="0 0 10 0" VerticalAlignment="Center"/>
                            <TextBlock Text="History" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Settings (standalone — avoids ListBox index mapping problem) -->
                <Border Grid.Row="2" BorderThickness="0 1 0 0" BorderBrush="{StaticResource BorderBrush}"
                        Padding="0 8 0 24">
                    <Button Click="SettingsNav_Click" Background="Transparent" BorderThickness="0"
                            Foreground="#94A3B8"
                            Cursor="Hand" HorizontalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bdr" CornerRadius="10" Background="Transparent" Margin="8 2">
                                    <Grid>
                                        <Border x:Name="Accent" Width="3" CornerRadius="2"
                                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                Visibility="Collapsed">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="16 11 12 11">
                                            <md:PackIcon Kind="Cog" Width="17" Height="17" Margin="0 0 10 0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{TemplateBinding Foreground}"/>
                                            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bdr" Property="Background" Value="#14112A"/>
                                        <Setter Property="Foreground" Value="#C4B5FD"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Path=DataContext.CurrentTabIndex,
                                                 RelativeSource={RelativeSource AncestorType=Window}}" Value="7">
                                        <Setter TargetName="Bdr" Property="Background" Value="#1A1540"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- User Panel -->
                <Border Grid.Row="3" Padding="14 12"
                        BorderThickness="0 1 0 0" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding CurrentUser.Initials, FallbackValue='?'}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="13"/>
                        </Border>

                        <!-- Name + email -->
                        <StackPanel Grid.Column="1" Margin="10 0 6 0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.ShortName, FallbackValue='Guest'}"
                                       FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUser.Email, FallbackValue='Guest mode'}"
                                       Foreground="{StaticResource MutedText}" FontSize="10"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Logout -->
                        <Button Grid.Column="2"
                                Command="{Binding LogoutCommand}"
                                Background="Transparent" BorderThickness="0"
                                Width="28" Height="28" Cursor="Hand"
                                ToolTip="Sign out"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr" CornerRadius="14" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#1E1A38"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <md:PackIcon Kind="LogoutVariant" Width="15" Height="15"
                                         Foreground="{StaticResource MutedText}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════ CONTENT AREA ════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ── Top Bar (drag area + window controls) ── -->
            <Border Grid.Row="0" Background="{StaticResource TopbarBg}"
                    BorderThickness="0 0 0 1" BorderBrush="{StaticResource BorderBrush}">
                <Grid Margin="20 0 0 0">
                    <!-- Breadcrumb -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Text="ResumeAI Pro"/>
                        <md:PackIcon Kind="ChevronRight" Width="14" Height="14"
                                     Foreground="{StaticResource MutedText}"
                                     VerticalAlignment="Center" Margin="6 0"/>
                        <TextBlock Text="{Binding CurrentTabTitle}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: actions + window controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding ClearAllCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Foreground="{StaticResource MutedText}"
                                Height="30" Padding="14 0" Cursor="Hand"
                                Margin="0 0 8 0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bdr" CornerRadius="15"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Refresh" Width="13" Height="13"
                                                         VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="New Analysis" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bdr" Property="Background" Value="#14112A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Window controls -->
                        <Button x:Name="MinBtn" Style="{StaticResource WinBtn}"
                                Click="MinBtn_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <md:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}"
                                Click="MaxBtn_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <md:PackIcon Kind="WindowMaximize" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource CloseWinBtn}"
                                Click="CloseBtn_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <md:PackIcon Kind="Close" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Loading Overlay ── -->
            <Grid Grid.Row="1" Panel.ZIndex="99"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                <Rectangle Fill="#CC07040F"/>
                <Border Background="#0E0B1E" CornerRadius="20" Padding="48 36"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="40" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="64" Height="64"
                                     Foreground="{StaticResource AccentCyan}"/>
                        <TextBlock Text="{Binding LoadingMessage}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Margin="0 20 0 0" TextAlignment="Center"/>
                        <TextBlock Text="Powered by Google Gemini AI"
                                   Foreground="{StaticResource MutedText}"
                                   FontSize="12" TextAlignment="Center" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Tab Control ── -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding CurrentTabIndex}"
                        Background="Transparent" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- ═══ TAB 0: DASHBOARD ═══ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32 28 32 28">

                            <!-- ── HEADER ──────────────────────────────────────── -->
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding DashboardGreeting}"
                                               FontSize="26" FontWeight="Bold"/>
                                    <TextBlock FontSize="13" Foreground="{StaticResource MutedText}"
                                               Margin="0 5 0 0"
                                               Visibility="{Binding AnalysisReady, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"
                                               Text="Let's optimize your resume and find your dream job."/>
                                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0"
                                                Visibility="{Binding AnalysisReady, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="Resume overview  ·  " FontSize="13" Foreground="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding ResumeData.FileName, FallbackValue=''}"
                                                   FontSize="13" Foreground="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Click="DashGoToUpload_Click" Style="{StaticResource GlowButton}"
                                            Height="40" Padding="18 0" Margin="0 0 10 0">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Upload" Width="15" Height="15"
                                                         VerticalAlignment="Center" Margin="0 0 7 0"/>
                                            <TextBlock Text="Upload Resume" VerticalAlignment="Center" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="DashGoToFinder_Click" Height="40" Padding="18 0" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bdr" CornerRadius="20"
                                                        BorderBrush="#1E1A38" BorderThickness="1"
                                                        Background="Transparent" Padding="18 0" Height="40">
                                                    <StackPanel Orientation="Horizontal">
                                                        <md:PackIcon Kind="MagnifyExpand" Width="15" Height="15"
                                                                     VerticalAlignment="Center" Margin="0 0 7 0"
                                                                     Foreground="{StaticResource MutedText}"/>
                                                        <TextBlock Text="Find Jobs" VerticalAlignment="Center"
                                                                   FontSize="13" Foreground="{StaticResource MutedText}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bdr" Property="Background" Value="#14112A"/>
                                                        <Setter TargetName="Bdr" Property="BorderBrush" Value="#3D3460"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ── EMPTY STATE (no analysis yet) ──────────────── -->
                            <StackPanel Margin="0 28 0 0"
                                        Visibility="{Binding AnalysisReady, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">

                                <!-- Hero section -->
                                <Grid Margin="0 0 0 28" Height="290">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="380"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: text + CTA -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 36 0">
                                        <!-- Badge: outline style like inspo -->
                                        <Border Background="Transparent" CornerRadius="20" Padding="12 5"
                                                HorizontalAlignment="Left" Margin="0 0 0 14"
                                                BorderThickness="1" BorderBrush="#3D2ED0">
                                            <TextBlock Text="AI POWERED CAREER INTELLIGENCE"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentCyan}"/>
                                        </Border>
                                        <!-- Heading with colored "AI" -->
                                        <TextBlock FontSize="32" FontWeight="Bold" Margin="0 0 0 10" TextWrapping="Wrap">
                                            <Run Text="Optimize Your Resume"/>
                                            <LineBreak/>
                                            <Run Text="with "/>
                                            <Run Text="AI" Foreground="{StaticResource AccentCyan}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="13" Foreground="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" Margin="0 0 0 18" LineHeight="22"
                                                   HorizontalAlignment="Left" TextAlignment="Left"
                                                   Text="Get AI-powered analysis, ATS score, job matches, and smart suggestions to land your dream job."/>
                                        <!-- CTA buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                            <Button Click="DashGoToUpload_Click" Style="{StaticResource GlowButton}"
                                                    Height="44" Padding="20 0" Margin="0 0 12 0">
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="Upload" Width="17" Height="17"
                                                                 VerticalAlignment="Center" Margin="0 0 9 0"/>
                                                    <TextBlock Text="Upload Resume" VerticalAlignment="Center"
                                                               FontSize="14" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="DashGoToFinder_Click" Cursor="Hand" Margin="0 0 0 0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bdr" CornerRadius="22" Height="44"
                                                                BorderBrush="#5B4FA0" BorderThickness="1.5"
                                                                Background="#1E1A3A" Padding="18 0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Try Demo" VerticalAlignment="Center"
                                                                           FontSize="14" Foreground="#C4B5FD"/>
                                                                <md:PackIcon Kind="ArrowRight" Width="15" Height="15"
                                                                             VerticalAlignment="Center" Margin="8 0 0 0"
                                                                             Foreground="#C4B5FD"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bdr" Property="BorderBrush" Value="#7C3AED"/>
                                                                <Setter TargetName="Bdr" Property="Background" Value="#2A2050"/>
                                                                <Setter TargetName="Bdr" Property="Effect">
                                                                    <Setter.Value><DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="14" Opacity="0.4"/></Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Supports PDF, DOCX, TXT  ·  Free to use"
                                                   FontSize="11" Foreground="#374151"/>
                                    </StackPanel>

                                    <!-- Right: hero image, no card border -->
                                    <Border Grid.Column="1" CornerRadius="16" ClipToBounds="True">
                                        <Image Source="pack://application:,,,/Assets/HeroSection_img.png"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Feature tiles -->
                                <TextBlock Text="WHAT YOU CAN DO" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource MutedText}" Margin="0 0 0 14"/>
                                <UniformGrid Rows="1" Columns="4" Margin="0 0 0 0">

                                    <!-- Tile 1: AI Resume Analysis — purple glow -->
                                    <Border x:Name="Tile1" CornerRadius="16" Margin="0 0 10 0" Cursor="Hand"
                                            BorderThickness="1" BorderBrush="#2A2050" Background="#17122E">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding AnalyzeResumeCommand}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1E1540"/>
                                                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value><DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="24" Opacity="0.5"/></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Margin="20 18 20 18">
                                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left" Margin="0 0 0 14">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#7C3AED" Offset="0"/><GradientStop Color="#5B21B6" Offset="1"/>
                                                </LinearGradientBrush></Border.Background>
                                                <md:PackIcon Kind="FileSearch" Width="22" Height="22" Foreground="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="AI Resume Analysis" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White" Margin="0 0 0 6"/>
                                            <TextBlock Text="Deep analysis with actionable insights and scores"
                                                       FontSize="11" Foreground="#8892A4" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tile 2: ATS Score Optimizer — cyan glow -->
                                    <Border CornerRadius="16" Margin="0 0 10 0" Cursor="Hand"
                                            BorderThickness="1" BorderBrush="#2A2050" Background="#17122E">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding AnalyzeResumeCommand}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0F1E28"/>
                                                        <Setter Property="BorderBrush" Value="#06B6D4"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value><DropShadowEffect Color="#06B6D4" ShadowDepth="0" BlurRadius="24" Opacity="0.5"/></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Margin="20 18 20 18">
                                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left" Margin="0 0 0 14">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#06B6D4" Offset="0"/><GradientStop Color="#0284C7" Offset="1"/>
                                                </LinearGradientBrush></Border.Background>
                                                <md:PackIcon Kind="ChartBar" Width="22" Height="22" Foreground="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="ATS Score Optimizer" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White" Margin="0 0 0 6"/>
                                            <TextBlock Text="Check ATS compatibility and fix issues fast"
                                                       FontSize="11" Foreground="#8892A4" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tile 3: Job Match Finder — green glow -->
                                    <Border CornerRadius="16" Margin="0 0 10 0" Cursor="Hand"
                                            BorderThickness="1" BorderBrush="#2A2050" Background="#17122E">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding MatchJobCommand}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0F2018"/>
                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value><DropShadowEffect Color="#10B981" ShadowDepth="0" BlurRadius="24" Opacity="0.5"/></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Margin="20 18 20 18">
                                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left" Margin="0 0 0 14">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/><GradientStop Color="#047857" Offset="1"/>
                                                </LinearGradientBrush></Border.Background>
                                                <md:PackIcon Kind="Target" Width="22" Height="22" Foreground="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Job Match Finder" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White" Margin="0 0 0 6"/>
                                            <TextBlock Text="Paste a job description and get a match score"
                                                       FontSize="11" Foreground="#8892A4" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tile 4: AI Cover Letter — amber glow -->
                                    <Border CornerRadius="16" Margin="0" Cursor="Hand"
                                            BorderThickness="1" BorderBrush="#2A2050" Background="#17122E">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding GenerateCoverLetterCommand}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#201808"/>
                                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value><DropShadowEffect Color="#F59E0B" ShadowDepth="0" BlurRadius="24" Opacity="0.5"/></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Margin="20 18 20 18">
                                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left" Margin="0 0 0 14">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F59E0B" Offset="0"/><GradientStop Color="#D97706" Offset="1"/>
                                                </LinearGradientBrush></Border.Background>
                                                <md:PackIcon Kind="FileEdit" Width="22" Height="22" Foreground="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="AI Cover Letter" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White" Margin="0 0 0 6"/>
                                            <TextBlock Text="Generate a tailored cover letter in seconds"
                                                       FontSize="11" Foreground="#8892A4" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Recent history when empty state -->
                                <StackPanel Margin="0 28 0 0"
                                            Visibility="{Binding History.Count, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="RECENT ACTIVITY" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedText}" Margin="0 0 0 12"/>
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="16 12" Margin="0 0 0 8"
                                                        BorderThickness="1" BorderBrush="#1A1535" Background="#0D0A1E">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                                Background="#1A0F35" Margin="0 0 14 0">
                                                            <md:PackIcon Kind="FileDocumentOutline" Width="18" Height="18"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         Foreground="{StaticResource PrimaryPurple}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ResumeFileName}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding JobTitle}" FontSize="11"
                                                                       Foreground="{StaticResource MutedText}" Margin="0 2 0 0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#1A0F35" CornerRadius="12" Padding="12 5" Margin="8 0">
                                                            <TextBlock FontSize="12">
                                                                <Run Text="ATS " Foreground="{StaticResource MutedText}"/>
                                                                <Run Text="{Binding AtsScore}" Foreground="{Binding AtsScore, Converter={StaticResource ScoreBrush}}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Grid.Column="3" Background="#0F1A18" CornerRadius="12" Padding="12 5">
                                                            <TextBlock FontSize="12">
                                                                <Run Text="Match " Foreground="{StaticResource MutedText}"/>
                                                                <Run Text="{Binding MatchScore}" Foreground="{Binding MatchScore, Converter={StaticResource ScoreBrush}}"/>
                                                                <Run Text="%" Foreground="{StaticResource MutedText}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- ── DATA STATE (analysis ready) ────────────────── -->
                            <StackPanel Margin="0 28 0 0"
                                        Visibility="{Binding AnalysisReady, Converter={StaticResource BoolVis}}">

                                <!-- Stats row — 4 cards -->
                                <UniformGrid Rows="1" Columns="4" Margin="0 0 0 20">

                                    <!-- ATS Score -->
                                    <Border Margin="0 0 12 0" CornerRadius="16" Padding="20 20"
                                            BorderThickness="1" BorderBrush="#221E40">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141028" Offset="0"/><GradientStop Color="#0C0A1C" Offset="1"/>
                                        </LinearGradientBrush></Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="ATS SCORE" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedText}"/>
                                            <Border Width="90" Height="90" CornerRadius="45"
                                                    BorderThickness="7"
                                                    BorderBrush="{Binding AnalysisResult.AtsScore, Converter={StaticResource ScoreBrush}}"
                                                    Background="#100C24" HorizontalAlignment="Center" Margin="0 14 0 14">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="20" Opacity="0.5"/>
                                                </Border.Effect>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding AnalysisResult.AtsScore}"
                                                               FontSize="28" FontWeight="Bold" TextAlignment="Center"
                                                               Foreground="{Binding AnalysisResult.AtsScore, Converter={StaticResource ScoreBrush}}"/>
                                                    <TextBlock Text="/100" FontSize="10" Foreground="{StaticResource MutedText}"
                                                               TextAlignment="Center" Margin="0 -3 0 0"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding DashboardScoreLabel}"
                                                       FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Experience -->
                                    <Border Margin="0 0 12 0" CornerRadius="16" Padding="20 20"
                                            BorderThickness="1" BorderBrush="#221E40">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141028" Offset="0"/><GradientStop Color="#0C0A1C" Offset="1"/>
                                        </LinearGradientBrush></Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="EXPERIENCE" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedText}"/>
                                            <md:PackIcon Kind="BriefcaseOutline" Width="32" Height="32"
                                                         Foreground="{StaticResource AccentCyan}"
                                                         HorizontalAlignment="Center" Margin="0 20 0 10"/>
                                            <TextBlock Text="{Binding AnalysisResult.ExperienceLevel, FallbackValue='—'}"
                                                       FontSize="22" FontWeight="Bold" TextAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 0">
                                                <TextBlock Text="{Binding AnalysisResult.YearsOfExperience, FallbackValue='0'}"
                                                           FontSize="12" Foreground="{StaticResource MutedText}"/>
                                                <TextBlock Text="+ years" FontSize="12" Foreground="{StaticResource MutedText}" Margin="3 0 0 0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Skills -->
                                    <Border Margin="0 0 12 0" CornerRadius="16" Padding="20 20"
                                            BorderThickness="1" BorderBrush="#221E40">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141028" Offset="0"/><GradientStop Color="#0C0A1C" Offset="1"/>
                                        </LinearGradientBrush></Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="SKILLS DETECTED" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedText}"/>
                                            <md:PackIcon Kind="CodeBraces" Width="32" Height="32"
                                                         Foreground="#10B981" HorizontalAlignment="Center" Margin="0 20 0 6"/>
                                            <TextBlock Text="{Binding DashboardSkillsCount}"
                                                       FontSize="36" FontWeight="Bold" TextAlignment="Center" Foreground="#10B981"/>
                                            <TextBlock Text="Technical + Soft Skills"
                                                       FontSize="11" Foreground="{StaticResource MutedText}"
                                                       TextAlignment="Center" Margin="0 4 0 0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Domain -->
                                    <Border CornerRadius="16" Padding="20 20"
                                            BorderThickness="1" BorderBrush="#221E40">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141028" Offset="0"/><GradientStop Color="#0C0A1C" Offset="1"/>
                                        </LinearGradientBrush></Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="PRIMARY DOMAIN" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedText}"/>
                                            <md:PackIcon Kind="Laptop" Width="32" Height="32"
                                                         Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0 20 0 8"/>
                                            <TextBlock Text="{Binding AnalysisResult.PrimaryDomain, FallbackValue='—'}"
                                                       FontSize="16" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AnalysisResult.ExperienceLevel, FallbackValue=''}"
                                                       FontSize="11" Foreground="{StaticResource MutedText}"
                                                       TextAlignment="Center" Margin="0 5 0 0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- AI Insights + Quick Actions -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="290"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- AI Insights -->
                                    <Border Grid.Column="0" CornerRadius="16" Padding="24"
                                            BorderThickness="1" BorderBrush="#221E40">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141028" Offset="0"/><GradientStop Color="#0C0A1C" Offset="1"/>
                                        </LinearGradientBrush></Border.Background>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                                                <md:PackIcon Kind="LightbulbOutline" Width="18" Height="18"
                                                             Foreground="#F59E0B" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                                <TextBlock Text="AI Insights" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Strengths -->
                                            <ItemsControl ItemsSource="{Binding DashboardTopStrengths}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                                            <Border Width="20" Height="20" CornerRadius="10"
                                                                    Background="#10B98122" Margin="0 0 12 0" VerticalAlignment="Top">
                                                                <md:PackIcon Kind="Check" Width="12" Height="12"
                                                                             Foreground="#10B981"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Weaknesses / Recommendations -->
                                            <ItemsControl ItemsSource="{Binding DashboardTopWeaknesses}" Margin="0 4 0 0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                                                            <Border Width="20" Height="20" CornerRadius="10"
                                                                    Background="#F59E0B22" Margin="0 0 12 0" VerticalAlignment="Top">
                                                                <md:PackIcon Kind="AlertOutline" Width="12" Height="12"
                                                                             Foreground="#F59E0B"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Click="DashGoToAnalysis_Click" Margin="0 16 0 0"
                                                    HorizontalAlignment="Left" Height="38" Padding="18 0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bdr" CornerRadius="19"
                                                                BorderBrush="#7C3AED" BorderThickness="1"
                                                                Background="Transparent" Padding="18 0" Height="38">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="View Full Analysis" FontSize="13"
                                                                           VerticalAlignment="Center" Foreground="{StaticResource PrimaryPurple}"/>
                                                                <md:PackIcon Kind="ArrowRight" Width="14" Height="14"
                                                                             VerticalAlignment="Center" Margin="8 0 0 0"
                                                                             Foreground="{StaticResource PrimaryPurple}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bdr" Property="Background" Value="#7C3AED22"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Actions -->
                                    <Border Grid.Column="2" CornerRadius="16" Padding="24"
                                            BorderThickness="1" BorderBrush="#221E40">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141028" Offset="0"/><GradientStop Color="#0C0A1C" Offset="1"/>
                                        </LinearGradientBrush></Border.Background>
                                        <StackPanel>
                                            <TextBlock Text="Quick Actions" FontSize="15" FontWeight="Bold" Margin="0 0 0 16"/>

                                            <!-- Shared action button style as inline template -->
                                            <Button Click="DashGoToAnalysis_Click" HorizontalAlignment="Stretch"
                                                    Margin="0 0 0 10" Height="44" Cursor="Hand" Background="#1A1535" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bdr" CornerRadius="12" Background="{TemplateBinding Background}" Padding="16 0">
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="28" Height="28" CornerRadius="8" Margin="0 0 12 0">
                                                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#7C3AED" Offset="0"/><GradientStop Color="#5B21B6" Offset="1"/>
                                                                        </LinearGradientBrush></Border.Background>
                                                                        <md:PackIcon Kind="ChartBar" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="View Full Analysis" FontSize="13" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <md:PackIcon Kind="ChevronRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bdr" Property="Background" Value="#221E40"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Click="DashGoToMatch_Click" HorizontalAlignment="Stretch"
                                                    Margin="0 0 0 10" Height="44" Cursor="Hand" Background="#1A1535" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bdr" CornerRadius="12" Background="{TemplateBinding Background}" Padding="16 0">
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="28" Height="28" CornerRadius="8" Margin="0 0 12 0">
                                                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#06B6D4" Offset="0"/><GradientStop Color="#0284C7" Offset="1"/>
                                                                        </LinearGradientBrush></Border.Background>
                                                                        <md:PackIcon Kind="Target" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="Match Job Description" FontSize="13" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <md:PackIcon Kind="ChevronRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bdr" Property="Background" Value="#221E40"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Click="DashGoToCoverLetter_Click" HorizontalAlignment="Stretch"
                                                    Margin="0 0 0 10" Height="44" Cursor="Hand" Background="#1A1535" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bdr" CornerRadius="12" Background="{TemplateBinding Background}" Padding="16 0">
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="28" Height="28" CornerRadius="8" Margin="0 0 12 0">
                                                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#F59E0B" Offset="0"/><GradientStop Color="#D97706" Offset="1"/>
                                                                        </LinearGradientBrush></Border.Background>
                                                                        <md:PackIcon Kind="FileEdit" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="Generate Cover Letter" FontSize="13" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <md:PackIcon Kind="ChevronRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bdr" Property="Background" Value="#221E40"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Click="DashGoToFinder_Click" HorizontalAlignment="Stretch"
                                                    Height="44" Cursor="Hand" Background="#1A1535" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bdr" CornerRadius="12" Background="{TemplateBinding Background}" Padding="16 0">
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="28" Height="28" CornerRadius="8" Margin="0 0 12 0">
                                                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#10B981" Offset="0"/><GradientStop Color="#047857" Offset="1"/>
                                                                        </LinearGradientBrush></Border.Background>
                                                                        <md:PackIcon Kind="MagnifyExpand" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="Find Job Opportunities" FontSize="13" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <md:PackIcon Kind="ChevronRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bdr" Property="Background" Value="#221E40"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Career tip -->
                                            <Border Background="#0F1A18" CornerRadius="12" Padding="16" Margin="0 12 0 0"
                                                    BorderThickness="1" BorderBrush="#0D2B23">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                                        <md:PackIcon Kind="LightbulbOn" Width="14" Height="14"
                                                                     Foreground="#10B981" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Career Tip" FontSize="11" FontWeight="Bold"
                                                                   Foreground="#10B981" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                                                               Text="Tailor your resume keywords to each job description to improve your ATS score by up to 40%."/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Recent Activity -->
                                <StackPanel Margin="0 20 0 0"
                                            Visibility="{Binding History.Count, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="RECENT ACTIVITY" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource MutedText}" Margin="0 0 0 12"/>
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="16 12" Margin="0 0 0 8"
                                                        BorderThickness="1" BorderBrush="#1A1535" Background="#0D0A1E">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                                Background="#1A0F35" Margin="0 0 14 0">
                                                            <md:PackIcon Kind="FileDocumentOutline" Width="18" Height="18"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                         Foreground="{StaticResource PrimaryPurple}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ResumeFileName}" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding JobTitle}" FontSize="11"
                                                                       Foreground="{StaticResource MutedText}" Margin="0 2 0 0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#1A0F35" CornerRadius="12" Padding="12 5" Margin="8 0">
                                                            <TextBlock FontSize="12">
                                                                <Run Text="ATS " Foreground="{StaticResource MutedText}"/>
                                                                <Run Text="{Binding AtsScore}" Foreground="{Binding AtsScore, Converter={StaticResource ScoreBrush}}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Grid.Column="3" Background="#0F1A18" CornerRadius="12" Padding="12 5">
                                                            <TextBlock FontSize="12">
                                                                <Run Text="Match " Foreground="{StaticResource MutedText}"/>
                                                                <Run Text="{Binding MatchScore}" Foreground="{Binding MatchScore, Converter={StaticResource ScoreBrush}}"/>
                                                                <Run Text="%" Foreground="{StaticResource MutedText}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 1: UPLOAD ═══ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Drop Zone + Preview -->
                            <StackPanel Grid.Column="0">
                                <Border x:Name="DropZone"
                                        CornerRadius="20" BorderThickness="2"
                                        BorderBrush="{StaticResource PrimaryPurple}"
                                        AllowDrop="True" Drop="DropZone_Drop"
                                        DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                        Cursor="Hand" MouseLeftButtonUp="DropZone_Click"
                                        MinHeight="300">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#120926" Offset="0"/>
                                            <GradientStop Color="#0C0A1E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="20" Opacity="0.2"/>
                                    </Border.Effect>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                                        <Border Width="80" Height="80" CornerRadius="40"
                                                Background="#1E1040" HorizontalAlignment="Center" Margin="0 0 0 20">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#06B6D4" ShadowDepth="0" BlurRadius="20" Opacity="0.4"/>
                                            </Border.Effect>
                                            <md:PackIcon Kind="FileDocumentOutline" Width="40" Height="40"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentCyan}"/>
                                        </Border>
                                        <TextBlock Text="{Binding UploadDropText}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   TextAlignment="Center" HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Supports PDF · DOCX · TXT"
                                                   Foreground="{StaticResource MutedText}"
                                                   FontSize="13" TextAlignment="Center" Margin="0 6 0 0"/>
                                        <Border Margin="0 22 0 0" CornerRadius="22"
                                                Width="160" Height="40" Cursor="Hand">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="16" Opacity="0.5"/>
                                            </Border.Effect>
                                            <TextBlock Text="Browse Files" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Margin="0 16 0 0" CornerRadius="10"
                                                Background="#064E3B" Padding="14 8"
                                                Visibility="{Binding ResumeUploaded, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="CheckCircle" Foreground="#10B981"
                                                             Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                <TextBlock Foreground="#10B981" FontWeight="SemiBold"
                                                           Text="Resume loaded successfully!"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Resume Text Preview -->
                                <Border Style="{StaticResource GlassCard}" Margin="0 18 0 0"
                                        Visibility="{Binding ResumeUploaded, Converter={StaticResource BoolVis}}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#06B6D4" ShadowDepth="0" BlurRadius="16" Opacity="0.1"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                            <md:PackIcon Kind="FileText" Foreground="{StaticResource AccentCyan}"
                                                         Width="18" Height="18" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Resume Text Preview" FontSize="14" FontWeight="Bold"/>
                                        </StackPanel>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <TextBox Text="{Binding ResumeData.RawText, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="#A78BFA" FontSize="12"
                                                     FontFamily="Consolas" Padding="4"/>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right Sidebar -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource GlassCard}" Margin="0 0 0 16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="20" Opacity="0.15"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="Quick Actions" FontSize="15" FontWeight="Bold" Margin="0 0 0 16"/>
                                        <Button Content="📤  Upload Resume"
                                                Command="{Binding UploadResumeCommand}"
                                                Style="{StaticResource GlowButton}"
                                                HorizontalAlignment="Stretch" Margin="0 0 0 10">
                                            <Button.Effect>
                                                <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="16" Opacity="0.5"/>
                                            </Button.Effect>
                                        </Button>
                                        <Button Content="🔬  Analyze Resume"
                                                Command="{Binding AnalyzeResumeCommand}"
                                                HorizontalAlignment="Stretch" Height="42"
                                                md:ButtonAssist.CornerRadius="21"
                                                IsEnabled="{Binding ResumeUploaded}"
                                                Background="#2D1B69" Foreground="White" BorderThickness="0"
                                                Margin="0 0 0 10"/>
                                        <Button Content="📊  Export Report"
                                                Command="{Binding ExportReportCommand}"
                                                HorizontalAlignment="Stretch" Height="42"
                                                md:ButtonAssist.CornerRadius="21"
                                                IsEnabled="{Binding AnalysisReady}"
                                                Background="#1e3a4a" Foreground="White" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCard}"
                                        Visibility="{Binding ResumeUploaded, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Resume Details" FontSize="15" FontWeight="Bold" Margin="0 0 0 16"/>
                                        <StackPanel Margin="0 0 0 10">
                                            <TextBlock Text="FILE" FontSize="10"
                                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 4"/>
                                            <TextBlock Text="{Binding ResumeData.FileName}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Margin="0 0 0 10"
                                                    Visibility="{Binding ResumeData.Email, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="EMAIL" FontSize="10"
                                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 4"/>
                                            <TextBlock Text="{Binding ResumeData.Email}"
                                                       Foreground="{StaticResource AccentCyan}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Margin="0 0 0 10"
                                                    Visibility="{Binding ResumeData.Phone, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="PHONE" FontSize="10"
                                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 4"/>
                                            <TextBlock Text="{Binding ResumeData.Phone}"/>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ResumeData.LinkedInUrl, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="LINKEDIN" FontSize="10"
                                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 4"/>
                                            <TextBlock Text="{Binding ResumeData.LinkedInUrl}"
                                                       Foreground="{StaticResource AccentCyan}"
                                                       TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCard}" Margin="0 16 0 0"
                                        Visibility="{Binding ResumeUploaded, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                                    <StackPanel>
                                        <TextBlock Text="Tips for best results"
                                                   FontSize="14" FontWeight="Bold" Margin="0 0 0 12"/>
                                        <TextBlock Text="• Use PDF or DOCX format"
                                                   Foreground="{StaticResource MutedText}" Margin="0 0 0 6" FontSize="13"/>
                                        <TextBlock Text="• Ensure text is selectable (not scanned)"
                                                   Foreground="{StaticResource MutedText}" Margin="0 0 0 6" FontSize="13"/>
                                        <TextBlock Text="• Include skills, experience and education"
                                                   Foreground="{StaticResource MutedText}" Margin="0 0 0 6" FontSize="13"/>
                                        <TextBlock Text="• Add metrics and achievements for higher ATS score"
                                                   Foreground="{StaticResource MutedText}" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 1: ANALYSIS ═══ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28">

                            <!-- Empty state -->
                            <Border Style="{StaticResource GlassCard}"
                                    Visibility="{Binding AnalysisReady, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                                <StackPanel HorizontalAlignment="Center" Margin="40">
                                    <md:PackIcon Kind="ChartBar" Width="60" Height="60"
                                                 Foreground="{StaticResource MutedText}"
                                                 HorizontalAlignment="Center" Margin="0 0 0 16"/>
                                    <TextBlock Text="No analysis yet" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Upload a resume and click Analyze to get your detailed AI report."
                                               Foreground="{StaticResource MutedText}"
                                               HorizontalAlignment="Center" Margin="0 8 0 24" TextAlignment="Center"/>
                                    <Button Content="Go to Upload →" Style="{StaticResource GlowButton}"
                                            HorizontalAlignment="Center" Click="GoToUpload_Click">
                                        <Button.Effect>
                                            <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="16" Opacity="0.5"/>
                                        </Button.Effect>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Results -->
                            <StackPanel Visibility="{Binding AnalysisReady, Converter={StaticResource BoolVis}}">

                                <!-- Row 1: ATS Arc + Summary + Tech Stack -->
                                <Grid Margin="0 0 0 18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ATS Score Arc -->
                                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="24" Opacity="0.2"/>
                                        </Border.Effect>
                                        <StackPanel HorizontalAlignment="Center">
                                            <ctrl:ScoreArcControl
                                                Value="{Binding AnalysisResult.AtsScore}"
                                                Label="ATS SCORE"
                                                HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding AnalysisResult.ExperienceLevel}"
                                                       FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource AccentCyan}" Margin="0 8 0 4">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#06B6D4" ShadowDepth="0" BlurRadius="10" Opacity="0.6"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="{Binding AnalysisResult.PrimaryDomain}"
                                                       FontSize="12" Foreground="{StaticResource MutedText}"
                                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                                       TextAlignment="Center"/>
                                            <TextBlock FontSize="12" Margin="0 6 0 0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedText}">
                                                <Run Text="{Binding AnalysisResult.YearsOfExperience}"/>
                                                <Run Text=" yrs experience"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- AI Summary + Sub-scores -->
                                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#06B6D4" ShadowDepth="0" BlurRadius="20" Opacity="0.08"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                                <md:PackIcon Kind="Robot" Foreground="{StaticResource AccentCyan}"
                                                             Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="AI Summary" FontSize="16" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AnalysisResult.OverallSummary}"
                                                       Foreground="#D1D5DB" TextWrapping="Wrap"
                                                       LineHeight="26" FontSize="14"/>

                                            <Grid Margin="0 18 0 0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#100D20" CornerRadius="12"
                                                        Padding="12 10" Margin="0 0 8 0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding AnalysisResult.Formatting.Score}"
                                                                   FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                                                   Foreground="{Binding AnalysisResult.Formatting.Score, Converter={StaticResource ScoreBrush}}"/>
                                                        <TextBlock Text="Formatting" FontSize="12"
                                                                   Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="#100D20" CornerRadius="12"
                                                        Padding="12 10" Margin="0 0 8 0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding AnalysisResult.Content.Score}"
                                                                   FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                                                   Foreground="{Binding AnalysisResult.Content.Score, Converter={StaticResource ScoreBrush}}"/>
                                                        <TextBlock Text="Content" FontSize="12"
                                                                   Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Background="#100D20" CornerRadius="12" Padding="12 10">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding AnalysisResult.Impact.Score}"
                                                                   FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                                                   Foreground="{Binding AnalysisResult.Impact.Score, Converter={StaticResource ScoreBrush}}"/>
                                                        <TextBlock Text="Impact" FontSize="12"
                                                                   Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Margin="0 14 0 0">
                                                <TextBlock Text="{Binding AnalysisResult.Formatting.Feedback}"
                                                           Foreground="{StaticResource MutedText}" FontSize="12"
                                                           Margin="0 0 0 4" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AnalysisResult.Content.Feedback}"
                                                           Foreground="{StaticResource MutedText}" FontSize="12"
                                                           Margin="0 0 0 4" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AnalysisResult.Impact.Feedback}"
                                                           Foreground="{StaticResource MutedText}" FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tech Stack -->
                                    <Border Grid.Column="4" Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                                <md:PackIcon Kind="CodeTags" Foreground="{StaticResource AccentCyan}"
                                                             Width="18" Height="18" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tech Stack" FontSize="14" FontWeight="Bold"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding AnalysisResult.TechStack}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource PillTag}">
                                                            <TextBlock Text="{Binding}" FontSize="12"
                                                                       Foreground="{StaticResource AccentCyan}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Soft Skills" FontSize="13" FontWeight="Bold" Margin="0 14 0 8"/>
                                            <ItemsControl ItemsSource="{Binding AnalysisResult.SoftSkills}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="12" Padding="10 4" Margin="4 4" Background="#1e3a2a">
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#6EE7B7"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Row 2: Skill Bars + Strengths + Improvements -->
                                <Grid Margin="0 0 0 18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Skill Proficiency -->
                                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                                                <md:PackIcon Kind="TrendingUp" Foreground="{StaticResource AccentCyan}"
                                                             Width="18" Height="18" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Skill Proficiency" FontSize="14" FontWeight="Bold"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding AnalysisResult.SkillCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0 0 0 14">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                                <TextBlock HorizontalAlignment="Right" FontSize="13"
                                                                           Foreground="{Binding Color, Converter={StaticResource HexBrush}}">
                                                                    <Run Text="{Binding Level}"/><Run Text="%"/>
                                                                </TextBlock>
                                                            </Grid>
                                                            <ProgressBar Value="{Binding Level}" Minimum="0" Maximum="100"
                                                                         Height="8"
                                                                         Foreground="{Binding Color, Converter={StaticResource HexBrush}}"
                                                                         Background="#1E1A38" BorderThickness="0"
                                                                         Margin="0 6 0 0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Strengths -->
                                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#10B981" ShadowDepth="0" BlurRadius="16" Opacity="0.08"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                                                <md:PackIcon Kind="ThumbUp" Foreground="#10B981"
                                                             Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Key Strengths" FontSize="14" FontWeight="Bold"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding AnalysisResult.Strengths}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#064E3B" CornerRadius="8"
                                                                Padding="12 8" Margin="0 0 0 8">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="CheckCircle" Foreground="#10B981"
                                                                             Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                           Foreground="#D1FAE5" FontSize="13"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Improvements -->
                                    <Border Grid.Column="4" Style="{StaticResource GlassCard}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#F59E0B" ShadowDepth="0" BlurRadius="16" Opacity="0.08"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                                                <md:PackIcon Kind="AlertCircle" Foreground="#F59E0B"
                                                             Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Improvements" FontSize="14" FontWeight="Bold"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding AnalysisResult.Weaknesses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#451A03" CornerRadius="8"
                                                                Padding="12 8" Margin="0 0 0 8">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="AlertOutline" Foreground="#F59E0B"
                                                                             Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                           Foreground="#FEF3C7" FontSize="13"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Action Items" FontSize="13" FontWeight="Bold" Margin="0 10 0 8"/>
                                            <ItemsControl ItemsSource="{Binding AnalysisResult.Recommendations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                                            <md:PackIcon Kind="LightbulbOutline"
                                                                         Foreground="{StaticResource AccentCyan}"
                                                                         Width="14" Height="14" Margin="0 2 8 0" VerticalAlignment="Top"/>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                       Foreground="#D1D5DB" FontSize="13"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- CTA Banner -->
                                <Border CornerRadius="14" Padding="24 18">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2D1B69" Offset="0"/>
                                            <GradientStop Color="#0e3a5c" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Ready to match a job or write a cover letter?"
                                                       FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Paste a job description to get your match score, or let AI write your cover letter."
                                                       Foreground="{StaticResource MutedText}" Margin="0 5 0 0" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Match a Job →" Style="{StaticResource GlowButton}"
                                                    Margin="0 0 10 0" Click="GoToMatch_Click">
                                                <Button.Effect>
                                                    <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="16" Opacity="0.5"/>
                                                </Button.Effect>
                                            </Button>
                                            <Button Content="Write Cover Letter →"
                                                    Click="GoToCoverLetter_Click"
                                                    Background="#1B4332" Foreground="White" BorderThickness="0"
                                                    Height="44" md:ButtonAssist.CornerRadius="22"
                                                    Padding="20 0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 2: JOB MATCH ═══ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource GlassCard}" VerticalAlignment="Top">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="20" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Job Details" FontSize="17" FontWeight="Bold" Margin="0 0 0 20"/>
                                    <TextBlock Text="JOB TITLE" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                    <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="e.g. Senior Software Engineer"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Foreground="White" Margin="0 0 0 16"/>
                                    <TextBlock Text="COMPANY (OPTIONAL)" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                    <TextBox Text="{Binding JobCompany, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="e.g. Google, Microsoft..."
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Foreground="White" Margin="0 0 0 16"/>
                                    <TextBlock Text="JOB DESCRIPTION *" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                    <TextBox Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="Paste the full job description here..."
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Foreground="White" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="240" MaxHeight="340" Margin="0 0 0 20"/>
                                    <Button Content="🔍  Match This Job"
                                            Command="{Binding MatchJobCommand}"
                                            Style="{StaticResource GlowButton}"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}">
                                        <Button.Effect>
                                            <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="16" Opacity="0.5"/>
                                        </Button.Effect>
                                    </Button>
                                    <Button Content="✉  Write Cover Letter for This Job"
                                            Click="GoToCoverLetter_Click"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"
                                            md:ButtonAssist.CornerRadius="21"
                                            Background="#1B4332" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource GlassCard}"
                                        Visibility="{Binding MatchReady, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                                    <StackPanel HorizontalAlignment="Center" Margin="20">
                                        <md:PackIcon Kind="Target" Width="50" Height="50"
                                                     Foreground="{StaticResource MutedText}"
                                                     HorizontalAlignment="Center" Margin="0 0 0 16"/>
                                        <TextBlock Text="Match results will appear here"
                                                   FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Fill in the job details on the left and click Match."
                                                   Foreground="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" Margin="0 8 0 0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding MatchReady, Converter={StaticResource BoolVis}}">
                                    <!-- Overall Score -->
                                    <Border Style="{StaticResource GlassCard}" Margin="0 0 0 16">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="24" Opacity="0.2"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ctrl:ScoreArcControl Grid.Column="0"
                                                Value="{Binding MatchResult.OverallMatchScore}"
                                                Label="MATCH SCORE" ShowSubText="False"
                                                HorizontalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="16 0 0 0" VerticalAlignment="Center">
                                                <Border CornerRadius="8" Padding="12 5"
                                                        HorizontalAlignment="Left" Margin="0 0 0 12"
                                                        Background="{Binding MatchResult.HiringOutlook, Converter={StaticResource OutlookColor}}">
                                                    <TextBlock Text="{Binding MatchResult.HiringOutlook}"
                                                               FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding MatchResult.MatchSummary}"
                                                           TextWrapping="Wrap" Foreground="#D1D5DB"
                                                           FontSize="13" LineHeight="24"/>
                                                <TextBlock Margin="0 10 0 0" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentCyan}"
                                                           Text="{Binding MatchResult.SalaryEstimate}">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="#06B6D4" ShadowDepth="0" BlurRadius="10" Opacity="0.5"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Score Breakdown + Skill Gap in columns -->
                                    <Grid Margin="0 0 0 16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                                            <StackPanel>
                                                <TextBlock Text="Score Breakdown" FontSize="14" FontWeight="Bold" Margin="0 0 0 16"/>
                                                <StackPanel Margin="0 0 0 10">
                                                    <Grid><TextBlock Text="Skills Match"/>
                                                    <TextBlock Text="{Binding MatchResult.SkillMatchScore}" HorizontalAlignment="Right"
                                                               Foreground="{Binding MatchResult.SkillMatchScore, Converter={StaticResource ScoreBrush}}"/></Grid>
                                                    <ProgressBar Value="{Binding MatchResult.SkillMatchScore}" Minimum="0" Maximum="100"
                                                                 Height="8" BorderThickness="0" Margin="0 5 0 0"
                                                                 Foreground="{Binding MatchResult.SkillMatchScore, Converter={StaticResource ScoreBrush}}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0 0 0 10">
                                                    <Grid><TextBlock Text="Experience"/>
                                                    <TextBlock Text="{Binding MatchResult.ExperienceMatchScore}" HorizontalAlignment="Right"
                                                               Foreground="{Binding MatchResult.ExperienceMatchScore, Converter={StaticResource ScoreBrush}}"/></Grid>
                                                    <ProgressBar Value="{Binding MatchResult.ExperienceMatchScore}" Minimum="0" Maximum="100"
                                                                 Height="8" BorderThickness="0" Margin="0 5 0 0"
                                                                 Foreground="{Binding MatchResult.ExperienceMatchScore, Converter={StaticResource ScoreBrush}}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0 0 0 10">
                                                    <Grid><TextBlock Text="Keywords"/>
                                                    <TextBlock Text="{Binding MatchResult.KeywordMatchScore}" HorizontalAlignment="Right"
                                                               Foreground="{Binding MatchResult.KeywordMatchScore, Converter={StaticResource ScoreBrush}}"/></Grid>
                                                    <ProgressBar Value="{Binding MatchResult.KeywordMatchScore}" Minimum="0" Maximum="100"
                                                                 Height="8" BorderThickness="0" Margin="0 5 0 0"
                                                                 Foreground="{Binding MatchResult.KeywordMatchScore, Converter={StaticResource ScoreBrush}}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <Grid><TextBlock Text="Education"/>
                                                    <TextBlock Text="{Binding MatchResult.EducationMatchScore}" HorizontalAlignment="Right"
                                                               Foreground="{Binding MatchResult.EducationMatchScore, Converter={StaticResource ScoreBrush}}"/></Grid>
                                                    <ProgressBar Value="{Binding MatchResult.EducationMatchScore}" Minimum="0" Maximum="100"
                                                                 Height="8" BorderThickness="0" Margin="0 5 0 0"
                                                                 Foreground="{Binding MatchResult.EducationMatchScore, Converter={StaticResource ScoreBrush}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                                            <StackPanel>
                                                <TextBlock Text="Skill Gap Analysis" FontSize="14" FontWeight="Bold" Margin="0 0 0 12"/>
                                                <TextBlock Text="✓  Matched" Foreground="#10B981"
                                                           FontWeight="SemiBold" FontSize="12" Margin="0 0 0 8"/>
                                                <ItemsControl ItemsSource="{Binding MatchResult.MatchedSkills}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource MatchedPill}">
                                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#6EE7B7"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="✗  Missing" Foreground="#EF4444"
                                                           FontWeight="SemiBold" FontSize="12" Margin="0 12 0 8"/>
                                                <ItemsControl ItemsSource="{Binding MatchResult.MissingSkills}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource MissingPill}">
                                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#FCA5A5"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="★  Bonus Skills" Foreground="#F59E0B"
                                                           FontWeight="SemiBold" FontSize="12" Margin="0 12 0 8"
                                                           Visibility="{Binding MatchResult.BonusSkills.Count, Converter={StaticResource BoolVis}}"/>
                                                <ItemsControl ItemsSource="{Binding MatchResult.BonusSkills}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="12" Padding="10 4" Margin="4 4" Background="#451A03">
                                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#FCD34D"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Interview + Tips -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Interview Prep Topics" FontSize="14" FontWeight="Bold" Margin="0 0 0 12"/>
                                                <ItemsControl ItemsSource="{Binding MatchResult.InterviewTopics}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                                                <md:PackIcon Kind="School" Foreground="{StaticResource AccentCyan}"
                                                                             Width="14" Height="14" Margin="0 2 8 0" VerticalAlignment="Top"/>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                           Foreground="#D1D5DB" FontSize="13"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Improvement Tips" FontSize="14" FontWeight="Bold" Margin="0 0 0 12"/>
                                                <ItemsControl ItemsSource="{Binding MatchResult.ImprovementTips}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                                                <md:PackIcon Kind="LightbulbOutline" Foreground="#F59E0B"
                                                                             Width="14" Height="14" Margin="0 2 8 0" VerticalAlignment="Top"/>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                           Foreground="#D1D5DB" FontSize="13"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 3: COVER LETTER ═══ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <Border Style="{StaticResource GlassCard}" Margin="0 0 0 16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="20" Opacity="0.15"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                                            <md:PackIcon Kind="FileEdit" Foreground="{StaticResource AccentCyan}"
                                                         Width="22" Height="22" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Cover Letter Generator" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="YOUR NAME" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                        <TextBox Text="{Binding CandidateName, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="e.g. Sarah Johnson"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Foreground="White" Margin="0 0 0 16"/>
                                        <TextBlock Text="JOB TITLE (OPTIONAL)" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                        <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="e.g. Senior Software Engineer"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Foreground="White" Margin="0 0 0 16"/>
                                        <TextBlock Text="COMPANY (OPTIONAL)" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                        <TextBox Text="{Binding JobCompany, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="e.g. Google"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Foreground="White" Margin="0 0 0 16"/>
                                        <TextBlock Text="JOB DESCRIPTION (OPTIONAL)" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                        <TextBox Text="{Binding JobDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="Paste job description for a more tailored letter..."
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Foreground="White" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="100" MaxHeight="180" Margin="0 0 0 20"/>
                                        <Button Content="✉  Generate Cover Letter"
                                                Command="{Binding GenerateCoverLetterCommand}"
                                                Style="{StaticResource GlowButton}"
                                                HorizontalAlignment="Stretch"
                                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}">
                                            <Button.Effect>
                                                <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="16" Opacity="0.5"/>
                                            </Button.Effect>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <TextBlock Text="How it works" FontSize="13" FontWeight="Bold" Margin="0 0 0 12"/>
                                        <TextBlock Text="1. Upload your resume (required)" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0 0 0 6"/>
                                        <TextBlock Text="2. Enter your name" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0 0 0 6"/>
                                        <TextBlock Text="3. Add job details for a tailored letter" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0 0 0 6"/>
                                        <TextBlock Text="4. Click Generate — AI writes your letter" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <Grid Margin="0 0 0 16">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Email" Foreground="{StaticResource AccentCyan}"
                                                         Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Generated Cover Letter" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Button Command="{Binding CopyCoverLetterCommand}"
                                                HorizontalAlignment="Right"
                                                Height="34" md:ButtonAssist.CornerRadius="17"
                                                Padding="14 0" Cursor="Hand"
                                                BorderThickness="0" Foreground="White"
                                                Visibility="{Binding CoverLetterReady, Converter={StaticResource BoolVis}}">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Copy" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Center" Margin="40"
                                                Visibility="{Binding CoverLetterReady, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                                        <md:PackIcon Kind="EmailOutline" Width="64" Height="64"
                                                     Foreground="{StaticResource MutedText}"
                                                     HorizontalAlignment="Center" Margin="0 0 0 16"/>
                                        <TextBlock Text="Your cover letter will appear here"
                                                   FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Fill in the form on the left and click Generate."
                                                   Foreground="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" Margin="0 8 0 0"/>
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding CoverLetterReady, Converter={StaticResource BoolVis}}">
                                        <Border Background="#100D20" CornerRadius="12" Padding="24">
                                            <TextBox Text="{Binding GeneratedCoverLetter, Mode=TwoWay}"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="#E5E7EB" FontSize="14"
                                                     FontFamily="Georgia"/>
                                        </Border>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 4: JOB FINDER ═══ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28">

                            <!-- Header -->
                            <Grid Margin="0 0 0 22">
                                <StackPanel>
                                    <TextBlock Text="Job Finder" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="Describe what you're looking for — AI finds matching opportunities"
                                               Foreground="{StaticResource MutedText}" Margin="0 5 0 0" FontSize="13"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        CornerRadius="10" Padding="14 7" Background="#1E1535"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="BriefcaseSearchOutline" Foreground="{StaticResource AccentCyan}"
                                                     Width="15" Height="15" Margin="0 0 7 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Powered by Gemini AI"
                                                   Foreground="{StaticResource AccentCyan}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Search Form -->
                            <Border Style="{StaticResource GlassCard}" Margin="0 0 0 20">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="20" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 18">
                                        <md:PackIcon Kind="Magnify" Foreground="{StaticResource AccentCyan}"
                                                     Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="What are you looking for?" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Role -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DESIRED ROLE *" FontSize="10"
                                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                            <TextBox Text="{Binding JobSearchRole, UpdateSourceTrigger=PropertyChanged}"
                                                     md:HintAssist.Hint="e.g. Software Engineer, Data Scientist..."
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Foreground="White"/>
                                        </StackPanel>

                                        <!-- Location -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="LOCATION" FontSize="10"
                                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                            <TextBox Text="{Binding JobSearchLocation, UpdateSourceTrigger=PropertyChanged}"
                                                     md:HintAssist.Hint="e.g. Remote, New York, Lahore..."
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Foreground="White"/>
                                        </StackPanel>

                                        <!-- Experience -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="EXPERIENCE" FontSize="10"
                                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                            <ComboBox SelectedValue="{Binding JobSearchExp}"
                                                      Foreground="White"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBoxItem Content="Junior" Foreground="White"/>
                                                <ComboBoxItem Content="Mid-level" Foreground="White"/>
                                                <ComboBoxItem Content="Senior" Foreground="White"/>
                                                <ComboBoxItem Content="Lead" Foreground="White"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Skills row -->
                                    <Grid Margin="0 16 0 20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="KEY SKILLS (optional)" FontSize="10"
                                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 6"/>
                                            <TextBox Text="{Binding JobSearchSkills, UpdateSourceTrigger=PropertyChanged}"
                                                     md:HintAssist.Hint="e.g. Python, React, Machine Learning..."
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Foreground="White"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="🔍  Find Jobs"
                                                Command="{Binding FindJobsCommand}"
                                                Style="{StaticResource GlowButton}"
                                                VerticalAlignment="Bottom" Padding="28 0"
                                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}">
                                            <Button.Effect>
                                                <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="16" Opacity="0.5"/>
                                            </Button.Effect>
                                        </Button>
                                    </Grid>

                                    <!-- Resume auto-fill hint -->
                                    <Border CornerRadius="8" Background="#0D1535" Padding="12 8"
                                            BorderBrush="#1E2A50" BorderThickness="1"
                                            Visibility="{Binding AnalysisReady, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="CheckCircleOutline" Foreground="#10B981"
                                                         Width="14" Height="14" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="#94A3B8" FontSize="12">
                                                <Run Text="Fields auto-filled from your resume analysis"/>
                                                <Run Text=" · " Foreground="#374151"/>
                                                <Run Text="Edit above to refine your search"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Empty / no results state -->
                            <Border Style="{StaticResource GlassCard}" Margin="0 0 0 20"
                                    Visibility="{Binding JobsFound, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                                <StackPanel HorizontalAlignment="Center" Margin="20 32">
                                    <md:PackIcon Kind="BriefcaseSearchOutline" Width="56" Height="56"
                                                 Foreground="{StaticResource MutedText}"
                                                 HorizontalAlignment="Center" Margin="0 0 0 16"/>
                                    <TextBlock Text="Your job listings will appear here"
                                               FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Enter a role above and click Find Jobs. No resume required."
                                               Foreground="{StaticResource MutedText}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Margin="0 8 0 0" MaxWidth="360"/>
                                </StackPanel>
                            </Border>

                            <!-- Job Cards -->
                            <ItemsControl ItemsSource="{Binding JobListings}"
                                          Visibility="{Binding JobsFound, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCard}" Margin="0 0 0 14">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="16" Opacity="0.1"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0 0 20 0">
                                                    <Grid Margin="0 0 0 8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                                            <TextBlock Margin="0 4 0 0">
                                                                <Run Text="{Binding Company}" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold"/>
                                                                <Run Text="  ·  " Foreground="{StaticResource MutedText}"/>
                                                                <Run Text="{Binding Location}" Foreground="{StaticResource MutedText}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                            <Border CornerRadius="10" Padding="10 4" Margin="4 0" Background="#2D1B69">
                                                                <TextBlock Text="{Binding JobType}" FontSize="11"
                                                                           Foreground="{StaticResource AccentCyan}"/>
                                                            </Border>
                                                            <Border CornerRadius="10" Padding="10 4" Background="#064E3B">
                                                                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#6EE7B7"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}"
                                                               TextWrapping="Wrap" Foreground="#D1D5DB"
                                                               FontSize="13" LineHeight="22" Margin="0 0 0 10"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                                        <md:PackIcon Kind="CurrencyUsd" Foreground="#10B981"
                                                                     Width="15" Height="15" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Salary}"
                                                                   Foreground="#10B981" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text=" · " Foreground="{StaticResource MutedText}" Margin="6 0"/>
                                                        <md:PackIcon Kind="ClockOutline" Foreground="{StaticResource MutedText}"
                                                                     Width="13" Height="13" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PostedDate}"
                                                                   Foreground="{StaticResource MutedText}" FontSize="12"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding RequiredSkills}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource PillTag}">
                                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                                               Foreground="{StaticResource AccentCyan}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Match Arc + Apply -->
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ctrl:ScoreArcControl
                                                        Value="{Binding MatchScore}"
                                                        Label="MATCH" ShowSubText="False"
                                                        HorizontalAlignment="Center"/>
                                                    <Button Content="Apply Now →"
                                                            Command="{Binding DataContext.OpenJobUrlCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding ApplyUrl}"
                                                            Height="36" md:ButtonAssist.CornerRadius="18"
                                                            Padding="14 0" Cursor="Hand" Margin="0 8 0 0"
                                                            BorderThickness="0" Foreground="White">
                                                        <Button.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#7C3AED" Offset="0"/>
                                                                <GradientStop Color="#06B6D4" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Button.Background>
                                                        <Button.Effect>
                                                            <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="12" Opacity="0.4"/>
                                                        </Button.Effect>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 5: HISTORY ═══ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28">
                            <Grid Margin="0 0 0 20">
                                <TextBlock Text="Analysis History" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Results auto-saved between sessions"
                                           Foreground="{StaticResource MutedText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                            </Grid>

                            <Border Style="{StaticResource GlassCard}"
                                    Visibility="{Binding History.Count, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                                <StackPanel HorizontalAlignment="Center" Margin="40">
                                    <md:PackIcon Kind="History" Width="50" Height="50"
                                                 Foreground="{StaticResource MutedText}"
                                                 HorizontalAlignment="Center" Margin="0 0 0 16"/>
                                    <TextBlock Text="No history yet" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Your completed analyses will appear here."
                                               Foreground="{StaticResource MutedText}"
                                               HorizontalAlignment="Center" Margin="0 8 0 0"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCard}" Margin="0 0 0 10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding JobTitle}" FontSize="15" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding ResumeFileName}"
                                                               Foreground="{StaticResource MutedText}" FontSize="12" Margin="0 4 0 0"/>
                                                    <TextBlock Text="{Binding AnalyzedAt, StringFormat='Analyzed {0:MMM dd, yyyy  hh:mm tt}'}"
                                                               Foreground="{StaticResource MutedText}" FontSize="11" Margin="0 3 0 0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AtsScore}"
                                                               FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                                               Foreground="{Binding AtsScore, Converter={StaticResource ScoreBrush}}">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#06B6D4" ShadowDepth="0" BlurRadius="12" Opacity="0.5"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <TextBlock Text="ATS" FontSize="11"
                                                               Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MatchScore}"
                                                               FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                                               Foreground="{Binding MatchScore, Converter={StaticResource ScoreBrush}}">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#10B981" ShadowDepth="0" BlurRadius="12" Opacity="0.5"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <TextBlock Text="Match %" FontSize="11"
                                                               Foreground="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 6: SETTINGS ═══ -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36" MaxWidth="680">
                            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Margin="0 0 0 6"/>
                            <TextBlock Text="Configure your API keys and preferences."
                                       Foreground="{StaticResource MutedText}" Margin="0 0 0 28" FontSize="13"/>

                            <!-- Gemini Key -->
                            <Border Style="{StaticResource GlassCard}" Margin="0 0 0 18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#06B6D4" ShadowDepth="0" BlurRadius="20" Opacity="0.1"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                        <md:PackIcon Kind="Key" Foreground="{StaticResource AccentCyan}"
                                                     Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Google Gemini API Key" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Margin="0 0 0 14" Foreground="{StaticResource MutedText}"
                                               TextWrapping="Wrap" FontSize="13"
                                               Text="Get your free key from aistudio.google.com. Required for all AI features. Stored locally only."/>
                                    <PasswordBox x:Name="ApiKeyBox"
                                                 md:HintAssist.Hint="AIza..."
                                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                                 PasswordChanged="ApiKeyBox_PasswordChanged"
                                                 Foreground="White" Margin="0 0 0 14"/>
                                    <Button Content="Save Gemini Key" Command="{Binding SaveApiKeyCommand}"
                                            Style="{StaticResource GlowButton}" Width="180" HorizontalAlignment="Left">
                                        <Button.Effect>
                                            <DropShadowEffect Color="#7C3AED" ShadowDepth="0" BlurRadius="14" Opacity="0.5"/>
                                        </Button.Effect>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Firebase Key -->
                            <Border Style="{StaticResource GlassCard}" Margin="0 0 0 18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#F59E0B" ShadowDepth="0" BlurRadius="20" Opacity="0.08"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                        <md:PackIcon Kind="Firebase" Foreground="#F59E0B"
                                                     Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Firebase Authentication (Optional)" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Margin="0 0 0 6" TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource MutedText}"
                                               Text="Enable user accounts. Create a Firebase project → Authentication → Email/Password → Project Settings → Web API Key."/>
                                    <Border Background="#0D1930" CornerRadius="8" Padding="12 8" Margin="0 0 0 14"
                                            BorderBrush="#1E3A5F" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Demo credentials (always work without Firebase):"
                                                       FontSize="11" Foreground="#06B6D4" FontWeight="SemiBold"/>
                                            <TextBlock Text="Email: demo@resumeaipro.com  ·  Password: Demo@1234"
                                                       FontSize="11" Foreground="#94A3B8" Margin="0 4 0 0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox Text="{Binding FirebaseApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="Firebase Web API Key (optional)"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Foreground="White" Margin="0 0 0 14"/>
                                    <Button Content="Save Firebase Key" Command="{Binding SaveFirebaseApiKeyCommand}"
                                            Style="{StaticResource GlowButton}" Width="200" HorizontalAlignment="Left">
                                        <Button.Effect>
                                            <DropShadowEffect Color="#F59E0B" ShadowDepth="0" BlurRadius="14" Opacity="0.4"/>
                                        </Button.Effect>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- How to use -->
                            <Border Style="{StaticResource GlassCard}" Margin="0 0 0 18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                                        <md:PackIcon Kind="InformationOutline" Foreground="{StaticResource AccentCyan}"
                                                     Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="How to Use ResumeAI Pro" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0 0 0 12">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Text="Step 1 — Upload"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                                                   Margin="0 4 0 0" FontSize="13"
                                                   Text="Drag and drop your resume (PDF or DOCX) onto the upload area, or click Browse Files."/>
                                    </StackPanel>
                                    <StackPanel Margin="0 0 0 12">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Text="Step 2 — Analyze"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                                                   Margin="0 4 0 0" FontSize="13"
                                                   Text="Gemini AI scores your resume for ATS compatibility, identifies skill gaps, and gives improvement recommendations."/>
                                    </StackPanel>
                                    <StackPanel Margin="0 0 0 12">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Text="Step 3 — Match a Job"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                                                   Margin="0 4 0 0" FontSize="13"
                                                   Text="Paste any job description to get a detailed match score, skill gap analysis, salary estimate, and interview prep topics."/>
                                    </StackPanel>
                                    <StackPanel Margin="0 0 0 12">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Text="Step 4 — Cover Letter"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                                                   Margin="0 4 0 0" FontSize="13"
                                                   Text="AI writes a tailored, professional cover letter based on your resume and the target job."/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Text="Step 5 — Job Finder"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                                                   Margin="0 4 0 0" FontSize="13"
                                                   Text="Gemini AI searches for real job listings that match your profile, with match scores and direct apply links."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- About -->
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="About" FontSize="15" FontWeight="Bold" Margin="0 0 0 12"/>
                                    <TextBlock Text="ResumeAI Pro v2.0" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentCyan}"/>
                                    <TextBlock Text="Built with C# · WPF · Material Design · Google Gemini AI · Firebase"
                                               Foreground="{StaticResource MutedText}" FontSize="13" Margin="0 6 0 0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- ── Status Bar ── -->
            <Border Grid.Row="2" Background="{StaticResource TopbarBg}"
                    BorderThickness="0 1 0 0" BorderBrush="{StaticResource BorderBrush}"
                    Padding="20 0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                        <md:PackIcon Kind="AlertCircle" Foreground="#EF4444"
                                     Width="13" Height="13" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#EF4444" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding HasError, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>

                    <TextBlock Text="ResumeAI Pro v2.0 · Google Gemini AI"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedText}" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
