<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ResumeAIPro</AssemblyName>
    <RootNamespace>ResumeAIPro</RootNamespace>
    <!-- Write source-generated files to disk so VS IntelliSense can see them -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\HeroSection_img.png" />
    <None Remove="Assets\ResumeAIPro_LOGO.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Material Design UI -->
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />

    <!-- PDF Parsing -->
    <PackageReference Include="itext7" Version="9.6.0" />

    <!-- DOCX Parsing -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\HeroSection_img.png" />
    <Resource Include="Assets\ResumeAIPro_LOGO.png" />
  </ItemGroup>

</Project>