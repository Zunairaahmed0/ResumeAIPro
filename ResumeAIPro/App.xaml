<Application x:Class="ResumeAIPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Cyan"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════ GLOBAL DEFAULTS ══════════ -->
            <!-- Ensure all text is white on dark backgrounds -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            </Style>

            <!-- ══════════ BRUSHES & COLORS ══════════ -->
            <SolidColorBrush x:Key="AppBg"           Color="#07040F"/>
            <SolidColorBrush x:Key="SidebarBg"       Color="#0B0718"/>
            <SolidColorBrush x:Key="TopbarBg"        Color="#0E0B1E"/>
            <SolidColorBrush x:Key="PrimaryPurple"   Color="#7C3AED"/>
            <SolidColorBrush x:Key="AccentCyan"      Color="#06B6D4"/>
            <SolidColorBrush x:Key="SuccessGreen"    Color="#10B981"/>
            <SolidColorBrush x:Key="WarningAmber"    Color="#F59E0B"/>
            <SolidColorBrush x:Key="DangerRed"       Color="#EF4444"/>
            <SolidColorBrush x:Key="MutedText"       Color="#64748B"/>
            <SolidColorBrush x:Key="BorderBrush"     Color="#1E1A38"/>
            <SolidColorBrush x:Key="CardBg"          Color="#100D20"/>
            <!-- Legacy compat alias -->
            <SolidColorBrush x:Key="DarkBg"          Color="#07040F"/>

            <!-- ══════════ GRADIENTS ══════════ -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#7C3AED" Offset="0"/>
                <GradientStop Color="#06B6D4" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#141028" Offset="0"/>
                <GradientStop Color="#0C0A1C" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0E0B1E" Offset="0"/>
                <GradientStop Color="#08060F" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#059669" Offset="0"/>
                <GradientStop Color="#0284C7" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a0533" Offset="0"/>
                <GradientStop Color="#0d1b2a" Offset="0.5"/>
                <GradientStop Color="#0a2540" Offset="1"/>
            </LinearGradientBrush>

            <!-- ══════════ GLASS CARD ══════════ -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background"      Value="{StaticResource CardGradient}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="16"/>
                <Setter Property="Padding"         Value="24"/>
            </Style>

            <!-- ══════════ GLOW PRIMARY BUTTON ══════════ -->
            <Style x:Key="GlowButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background"  Value="{StaticResource AccentGradient}"/>
                <Setter Property="Foreground"  Value="White"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="Height"      Value="44"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="22"/>
                <Setter Property="Padding"     Value="24 0"/>
                <Setter Property="Cursor"      Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- ══════════ GHOST BUTTON ══════════ -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource MutedText}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                <Setter Property="Height"          Value="44"/>
                <Setter Property="Padding"         Value="24 0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bdr" CornerRadius="22"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bdr" Property="Background" Value="#14112A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════ WINDOW CONTROL BUTTONS ══════════ -->
            <Style x:Key="WinBtn" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource MutedText}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width"           Value="44"/>
                <Setter Property="Height"          Value="44"/>
                <Setter Property="FontSize"        Value="13"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bdr" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bdr" Property="Background" Value="#1E1A38"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseWinBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bdr" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bdr" Property="Background" Value="#C0392B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════ SIDEBAR NAV ITEM ══════════ -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Foreground"               Value="{StaticResource MutedText}"/>
                <Setter Property="Cursor"                   Value="Hand"/>
                <Setter Property="Margin"                   Value="8 2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bdr" CornerRadius="10" Background="Transparent">
                                <Grid>
                                    <Border x:Name="Accent" Width="3" CornerRadius="2"
                                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                            Visibility="Collapsed">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#7C3AED" Offset="0"/>
                                                <GradientStop Color="#06B6D4" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter Margin="16 11 12 11"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bdr"    Property="Background"  Value="#1A1540"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter TargetName="Accent" Property="Visibility"  Value="Visible"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver"  Value="True"/>
                                        <Condition Property="IsSelected"   Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bdr" Property="Background" Value="#14112A"/>
                                    <Setter Property="Foreground" Value="#C4B5FD"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════ PILL TAGS ══════════ -->
            <Style x:Key="PillTag" TargetType="Border">
                <Setter Property="CornerRadius"    Value="12"/>
                <Setter Property="Padding"         Value="10 4"/>
                <Setter Property="Margin"          Value="4 4"/>
                <Setter Property="Background"      Value="#2D1B69"/>
            </Style>

            <Style x:Key="MatchedPill" TargetType="Border" BasedOn="{StaticResource PillTag}">
                <Setter Property="Background" Value="#064E3B"/>
            </Style>

            <Style x:Key="MissingPill" TargetType="Border" BasedOn="{StaticResource PillTag}">
                <Setter Property="Background" Value="#7F1D1D"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
