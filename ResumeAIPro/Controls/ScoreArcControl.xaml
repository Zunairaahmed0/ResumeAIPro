<UserControl x:Class="ResumeAIPro.Controls.ScoreArcControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160" Height="160">
    <Canvas Width="160" Height="160">
        <!-- Background track -->
        <Path x:Name="BackArc"
              Fill="Transparent"
              Stroke="#1A1535"
              StrokeThickness="12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <!-- Foreground arc with glow -->
        <Path x:Name="ForeArc"
              Fill="Transparent"
              StrokeThickness="12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round">
            <Path.Effect>
                <DropShadowEffect x:Name="ArcGlow"
                                  Color="#06B6D4"
                                  ShadowDepth="0"
                                  BlurRadius="14"
                                  Opacity="0.9"/>
            </Path.Effect>
        </Path>

        <!-- Score value with glow -->
        <TextBlock x:Name="ValueText"
                   Canvas.Left="0"
                   Canvas.Top="46"
                   Width="160"
                   TextAlignment="Center"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="White">
            <TextBlock.Effect>
                <DropShadowEffect x:Name="TextGlow"
                                  Color="#06B6D4"
                                  ShadowDepth="0"
                                  BlurRadius="18"
                                  Opacity="0.7"/>
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock x:Name="SubText"
                   Canvas.Left="0"
                   Canvas.Top="76"
                   Width="160"
                   TextAlignment="Center"
                   FontSize="13"
                   Foreground="#4B5563"
                   Text="/100"/>

        <TextBlock x:Name="LabelText"
                   Canvas.Left="0"
                   Canvas.Top="96"
                   Width="160"
                   TextAlignment="Center"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="#6B7280"/>
    </Canvas>
</UserControl>
